{
    "name": "banyancms/filament-media-library",
    "description": "A governed media library for any Filament v5 panel: alt text required, focal-point crops, versioned replacements, licence expiry, usage tracking and signed renditions. Part of Banyan, usable without it.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "laravel",
        "media library",
        "dam",
        "focal point",
        "alt text",
        "banyan"
    ],
    "homepage": "https://github.com/BanyanCMS/banyan",
    "support": {
        "issues": "https://github.com/BanyanCMS/banyan/issues",
        "source": "https://github.com/BanyanCMS/banyan",
        "security": "https://github.com/BanyanCMS/banyan/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "intervention/image": "^3.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "suggest": {
        "ext-gd": "The default rendition driver.",
        "ext-imagick": "An alternative rendition driver; set media-library.driver to 'imagick'."
    },
    "autoload": {
        "psr-4": {
            "Banyan\\FilamentMediaLibrary\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Banyan\\FilamentMediaLibrary\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Banyan\\FilamentMediaLibrary\\MediaLibraryServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
